# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored. NEVER commit real keys.

# --- Supabase (Project Settings -> API) ---
# Safe for the browser: the project URL and the publishable (anon) key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# SERVER ONLY. Full database access. Never add a NEXT_PUBLIC_ prefix,
# never log it, never paste it in chat or in a PR.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI (Ask the Hub) ---
# "mock" returns a canned answer and never calls a real model.
# Use "groq" only when you have your own key.
AI_PROVIDER=mock
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.1-8b-instant
